<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Define um appenders para enviar logs ao Graylog via GELF -->
    <!--
        Configure a GELF appender to forward logs to the Graylog instance defined in
        the docker‑compose file.  This uses the official `logback-gelf` appender
        maintained under the `de.siegmar` namespace.  The previous configuration
        referenced the old `de.svenkubiak` appender, which is no longer present
        after switching dependencies.  See the project documentation for details
        on available parameters【815575965194405†L332-L340】.
    -->
    <appender name="GELF" class="de.siegmar.logbackgelf.GelfUdpAppender">
        <!-- Hostname of the Graylog server.  Docker Compose exposes the service
             as "graylog" on the default GELF UDP port. -->
        <graylogHost>graylog</graylogHost>
        <graylogPort>12201</graylogPort>

        <!-- Optional encoder.  This encoder attaches additional metadata to each
             GELF message (e.g. origin host) and controls how the message is
             formatted.  The originHost parameter helps identify which service
             produced the log entry. -->
        <encoder class="de.siegmar.logbackgelf.GelfEncoder">
            <originHost>modulo1-app</originHost>
            <includeRawMessage>false</includeRawMessage>
            <includeKeyValues>true</includeKeyValues>
        </encoder>
    </appender>

    <!-- Console appender padrão -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="GELF" />
    </root>
</configuration>